{
  "warehouses": {
    "lab_wh": {
      "name": "SF_SNOWPIPE_DYT_PIPELINE_WH",
      "comment": "Lab warehouse for the loading data for the piepeline",
      "warehouse_size": "X-SMALL",
      "auto_resume": true,
      "auto_suspend": 60,
      "enable_query_acceleration": false,
      "warehouse_type": "STANDARD",
      "min_cluster_count": 1,
      "max_cluster_count": 1,
      "scaling_policy": "STANDARD",
      "initially_suspended": false
    }
  },
  "databases": {
    "dyt_db": {
      "name": "SF_SNOWPIPE_DYT_PIPELINE_DB",
      "comment": "Database for Snowpipe and Dynamic Tables data pipeline",
      "schemas": [
        {
          "name": "SOURCE",
          "comment": "Schema for ingesting raw data from external sources via Snowpipe",
          "file_formats": {
            "csv_file_format": {
              "name": "CSV_FILE_FORMAT",
              "type": "CSV",
              "compression": "AUTO",
              "field_delimiter": ",",
              "record_delimiter": "\n",
              "skip_header": 1,
              "field_optionally_enclosed_by": "\"",
              "trim_space": true,
              "null_if": ["NULL", "null", ""],
              "empty_field_as_null": true,
              "error_on_column_count_mismatch": false,
              "escape_unenclosed_field": "\\",
              "comment": "CSV file format for structured data ingestion"
            }
          },
          "stages": {
            "raw_internal_stg": {
              "name": "RAW_INTERNAL_STG",
              "stage_type": "internal",
              "file_format": "CSV_FILE_FORMAT",
              "directory_enabled": true,
              "comment": "Internal stage for staging raw data files before loading into tables"
            }
          }
        },
        {
          "name": "RAW",
          "comment": "Schema for storing unprocessed data in its original format",
          "tables": {
            "employee": {
              "name": "EMPLOYEE",
              "table_type": "PERMANENT",
              "comment": "Employee data table for storing raw employee records",
              "columns": [
                {
                  "name": "EMP_ID",
                  "type": "TEXT",
                  "nullable": false,
                  "comment": "Employee unique identifier"
                },
                {
                  "name": "FIRST_NAME",
                  "type": "TEXT",
                  "nullable": true,
                  "comment": "Employee first name"
                },
                {
                  "name": "LAST_NAME",
                  "type": "TEXT",
                  "nullable": true,
                  "comment": "Employee last name"
                },
                {
                  "name": "DATE_OF_BIRTH",
                  "type": "DATE",
                  "nullable": true,
                  "comment": "Employee date of birth"
                },
                {
                  "name": "DATE_OF_JOINING",
                  "type": "DATE",
                  "nullable": true,
                  "comment": "Employee joining date"
                },
                {
                  "name": "EMAIL_ADDRESS",
                  "type": "TEXT",
                  "nullable": true,
                  "comment": "Employee email address"
                },
                {
                  "name": "DEPARTMENT",
                  "type": "TEXT",
                  "nullable": true,
                  "comment": "Employee department"
                },
                {
                  "name": "DESIGNATION",
                  "type": "TEXT",
                  "nullable": true,
                  "comment": "Employee job designation"
                },
                {
                  "name": "LEVEL",
                  "type": "TEXT",
                  "nullable": true,
                  "comment": "Employee level in organization"
                },
                {
                  "name": "OFFICE_LOCATION",
                  "type": "TEXT",
                  "nullable": true,
                  "comment": "Employee office location"
                },
                {
                  "name": "ACTIVE",
                  "type": "TEXT",
                  "nullable": true,
                  "comment": "Employee active status"
                },
                {
                  "name": "LOAD_TS",
                  "type": "TIMESTAMP",
                  "nullable": true,
                  "comment": "Record load timestamp"
                },
                {
                  "name": "LOAD_ROW_NUMBER",
                  "type": "NUMBER",
                  "nullable": true,
                  "comment": "Row number from source file"
                },
                {
                  "name": "LOAD_FILE_NAME",
                  "type": "TEXT",
                  "nullable": true,
                  "comment": "Source file name"
                }
              ],
              "primary_key": {
                "keys": ["EMP_ID"]
              }
            }
          }
        },
        {
          "name": "CLEAN",
          "comment": "Schema for validated and transformed data ready for processing"
        },
        {
          "name": "CONSUMPTION",
          "comment": "Schema for curated data optimized for analytics and reporting"
        }
      ]
    }
  }
}